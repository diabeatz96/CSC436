<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Banhmigos Park Place</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="container py-3 site-header">
    <p class="brand mb-1">Banhmigos Park Place</p>
    <p>636 Park Place, Brooklyn, NY</p>
  </header>

  <main class="container">
    <section class="py-4">
      <h1>Order Banhmigos</h1>
      <p>Grab a bánh mì, a rice box, or bubble tea from our kitchen.</p>
      <div class="order-options"><p>Pickup</p><p>Delivery</p></div>
    </section>

    <section>
      <h2>Sandwiches</h2>
      <div class="menu-grid">
      <div class="menu-card p-3 mb-3">
        <h3>Grilled Pork Bánh Mì</h3>
        <p>Flame-grilled pork, cucumber, cilantro, and pickled carrot on a crisp baguette.</p>
        <div class="card-action"><p>$12.25</p><button>Add</button></div>
      </div>
      <div class="menu-card p-3 mb-3">
        <h3>Grilled Chicken Bánh Mì</h3>
        <p>Marinated grilled chicken with fresh herbs and pickled vegetables.</p>
        <div class="card-action"><p>$12.25</p><button>Add</button></div>
      </div>
      </div>
    </section>

    <section>
      <h2>Appetizer</h2>
      <div class="menu-grid">
      <div class="menu-card p-3 mb-3">
        <h3>Shrimp Summer Rolls</h3>
        <p>Fresh greens, rice vermicelli, shrimp, and peanut hoisin sauce.</p>
        <div class="card-action"><p>$8.50</p><button>Add</button></div>
      </div>
      </div>
    </section>

    <section>
      <h2>Rice Boxes</h2>
      <div class="menu-grid">
      <div class="menu-card p-3 mb-3">
        <h3>Grilled Pork Rice Box</h3>
        <p>Jasmine rice, grilled pork, side salad, egg, roasted peanuts, and fish sauce.</p>
        <div class="card-action"><p>$12.50</p><button>Add</button></div>
      </div>
      </div>
    </section>

    <section>
      <h2>Beverages</h2>
      <div class="menu-grid">
      <div class="menu-card p-3 mb-3">
        <h3>Original Bubble Tea</h3>
        <p>Black tea with non-dairy creamer and chewy tapioca pearls.</p>
        <div class="card-action"><p>$5.75</p><button>Add</button></div>
      </div>
      </div>
    </section>
  </main>

  <footer class="container py-4">
    <p>Open 11:30 AM–9:00 PM</p>
  </footer>

  <script src="script.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
